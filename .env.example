PORT=3034

# Secreto para hashes privados de seguridad; no se almacena dentro de la cookie.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=
APP_URL=http://localhost:3034

# Entrega de invitaciones y recuperación (por ejemplo, webhook de n8n).
# En desarrollo puede quedar vacío: la interfaz mostrará el enlace de prueba.
IDENTITY_WEBHOOK_URL=
IDENTITY_WEBHOOK_SECRET=replace-with-an-independent-signing-secret

# PostgreSQL local de docker-compose.yml
POSTGRES_DB=norug_research
POSTGRES_USER=norug
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_APP_USER=norug_app
POSTGRES_APP_PASSWORD=change-this-app-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://norug_app:change-this-app-password@localhost:5432/norug_research

# No redefinas DATABASE_URL con otro usuario o contraseña en .env.local.
# Los comandos db:env-check, db:migrate y test:db usan la misma precedencia que Next.js.

# Active SSL for managed PostgreSQL providers. Keep false for local Docker.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Ingesta S3-compatible. Para desarrollo local con `docker compose up`, estos
# valores coinciden con MinIO. En producción usa S3, R2 o un MinIO privado.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=norug-research
S3_ACCESS_KEY_ID=norug-minio
S3_SECRET_ACCESS_KEY=change-this-minio-password
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
UPLOAD_MAX_BYTES=52428800

# Cola de trabajos. La aplicación escribe el outbox en PostgreSQL y el worker
# lo entrega a BullMQ; no es necesario exponer Redis públicamente.
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=3
WORKER_DATABASE_POOL_MAX=5
MINIO_ROOT_USER=norug-minio
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
