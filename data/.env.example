PORT=3034

ADMIN_EMAIL=admin@norug.es
# Solo para desarrollo local. Cambie esta contraseña antes de desplegar.
ADMIN_PASSWORD=norug-demo
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=

# PostgreSQL local de docker-compose.yml
POSTGRES_DB=norug_research
POSTGRES_USER=norug
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://norug:change-this-database-password@localhost:5432/norug_research

# Active SSL for managed PostgreSQL providers. Keep false for local Docker.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
