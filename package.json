{
  "name": "norug-research-studio",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3034",
    "build": "next build",
    "start": "next start -p 3034",
    "worker:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/ingestion-worker.ts",
    "typecheck:worker": "tsc -p tsconfig.db.json --noEmit",
    "ingestion:health-check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/check-ingestion.ts",
    "db:env-check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/check-env.ts",
    "predb:migrate": "npm run db:env-check",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts",
    "predb:import-sqlite": "npm run db:env-check",
    "db:import-sqlite": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/import-sqlite.ts",
    "env:production-check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/check-production-env.ts",
    "backup:db": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1",
    "backup:verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify-backup.ps1",
    "lint": "eslint .",
    "test:structure": "node --test tests/structure.test.mjs",
    "test:identity": "node --experimental-strip-types --test tests/identity.unit.test.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.unit.test.mjs",
    "test:ingestion": "node --experimental-strip-types --test tests/ingestion.unit.test.mjs",
    "pretest:db": "npm run db:env-check",
    "test:db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types --test tests/postgres.integration.test.mjs",
    "test": "npm run test:structure && npm run test:identity && npm run test:security && npm run test:ingestion && npm run build",
    "check": "npm run lint && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@aws-sdk/s3-request-presigner": "3.1112.0",
    "bullmq": "6.1.2",
    "ioredis": "6.0.0",
    "next": "^16.3.1",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "NoRug Research Studio"
}
