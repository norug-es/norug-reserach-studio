{
  "name": "norug-research-studio",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3034",
    "build": "next build",
    "start": "next start -p 3034",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "db:import-sqlite": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-sqlite.ts",
    "lint": "eslint .",
    "test:structure": "node --test tests/structure.test.mjs",
    "test:db": "node --env-file-if-exists=.env --experimental-strip-types --test tests/postgres.integration.test.mjs",
    "test": "npm run test:structure && npm run build",
    "check": "npm run lint && npm run test"
  },
  "dependencies": {
    "next": "^16.3.1",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "NoRug Research Studio"
}
